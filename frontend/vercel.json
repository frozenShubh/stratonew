{
  "outputDirectory": "build",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/shubham", "destination": "/shubham.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|shubham|static/|favicon|logo|sitemap|robots).*)", "destination": "/index.html" }
  ]
}
