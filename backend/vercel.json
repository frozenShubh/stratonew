{
  "version": 2,
  "builds": [
    {
      "src": "server.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "functions": {
    "server.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.py"
    }
  ],
  "crons": [
    {
      "path": "/api/agent/weekly-post",
      "schedule": "0 9 * * 3"
    }
  ]
}
